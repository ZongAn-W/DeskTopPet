<Window x:Class="DesktopPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Pet"
        Width="180" Height="210"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True">
    <Grid Background="Transparent">
        <local:PetVisual x:Name="Pet" xmlns:local="clr-namespace:DesktopPet" />
    </Grid>
</Window>
