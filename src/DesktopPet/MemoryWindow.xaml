<Window x:Class="DesktopPet.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记忆管理" Width="760" Height="660" MinWidth="660" MinHeight="570"
        WindowStartupLocation="CenterOwner" Background="#FAF8FC" Foreground="#352E3C"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#756A7D"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#DCD4E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F1EDF4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EEE5F5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#956B88"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="她记得什么" FontSize="24" FontWeight="SemiBold" Foreground="#493958"/>
                <TextBlock Text="查看和调整她在聊天中记下的事。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="OpenDocumentButton" Grid.Column="1" Content="打开文档" VerticalAlignment="Center" Click="OnOpenDocument"
                    ToolTip="用默认程序打开 Markdown 记忆文档"/>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#E5DEE9" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,18">
            <StackPanel>
                <CheckBox x:Name="RecordingCheckBox" Content="自动记录新记忆" Checked="OnRecordingChanged" Unchecked="OnRecordingChanged"/>
                <TextBlock x:Name="RecordingHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="20,6,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索记忆" ToolTip="搜索记忆内容或主题" TextChanged="OnSearchChanged"/>
                    <TextBlock Text="搜索内容或主题" Margin="10,8" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="NotesList" SelectionChanged="OnSelectionChanged" BorderThickness="0" Background="#FFFDFF"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="记忆列表">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#493958" FontSize="12" Margin="10,14,10,4"/></DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Text}" ToolTip="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="12,24" Visibility="Collapsed"/>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="AddButton" Content="添加记忆" HorizontalAlignment="Right" Click="OnAdd"/>
                </DockPanel>
            </Grid>
            <Grid Grid.Column="2">
                <TextBlock x:Name="SelectionHint" Text="选一条记忆，就能修改内容和主题。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,30,0,0"/>
                <Grid x:Name="EditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="主题" Target="{Binding ElementName=SectionBox}" Padding="0" Margin="0,0,0,7"/>
                    <ComboBox x:Name="SectionBox" Grid.Row="1" IsEditable="True" Padding="7,5" Margin="0,0,0,16" AutomationProperties.Name="记忆主题"/>
                    <Label Grid.Row="2" Content="记忆内容" Target="{Binding ElementName=NoteTextBox}" Padding="0" Margin="0,0,0,7"/>
                    <TextBox x:Name="NoteTextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="记忆内容" TextChanged="OnEditorChanged" MaxLength="10000"/>
                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="修改后点击下方保存。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Button x:Name="DeleteButton" Content="删除这条" Foreground="#98435B" HorizontalAlignment="Right" Click="OnDelete"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,14">
            <TextBlock Text="保存后以你的修改为准；修改前尚未整理的对话会被丢弃，避免旧摘要恢复已删除的内容。"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#756A7D" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DockPanel Grid.Row="4">
            <Button x:Name="ReloadButton" Content="重新读取" Margin="0" HorizontalAlignment="Left" Click="OnReload"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RevertButton" Content="撤销修改" Click="OnRevert"/>
                <Button x:Name="CloseButton" Content="关闭" Click="OnClose"/>
                <Button x:Name="SaveButton" Content="保存修改" Background="#EEE5F5" MinWidth="90" Click="OnSave"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
