<Window x:Class="DesktopPet.BubbleChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天气泡" Width="360" Height="430" MinWidth="300" MinHeight="300"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        Background="#FAF8FC" FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="Manual">
    <Border BorderBrush="#D9CCDF" BorderThickness="1" CornerRadius="14" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="轻量气泡" Foreground="#493958" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Foreground="#756A7D" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NewChatButton" Content="新对话" Click="OnNewChat" Padding="7,4" Margin="4,0,0,0"/>
                    <Button x:Name="ExpandButton" Content="展开" Click="OnExpand" Padding="7,4" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="9" Padding="9" Margin="0,0,2,7">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#756A7D" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Padding="0" Foreground="#352E3C"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBox x:Name="InputBox" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" MaxHeight="100"
                     VerticalScrollBarVisibility="Auto" Padding="8" MaxLength="4000" PreviewKeyDown="OnInputKeyDown"
                     GotKeyboardFocus="OnInputFocused" TextChanged="OnInputTextChanged"/>
            <Button x:Name="SendButton" Grid.Row="3" Content="发送" Click="OnSend" HorizontalAlignment="Right" MinWidth="64"
                    Padding="9,5" Margin="0,8,0,0" Background="#EEE5F5"/>
        </Grid>
    </Border>
</Window>
