<Window x:Class="DesktopPet.BubbleChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和她聊聊" Width="368" MinWidth="300" MinHeight="180" MaxHeight="520"
        SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#433B42"
        UseLayoutRounding="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFFDFA"/>
        <SolidColorBrush x:Key="LineBrush" Color="#ECE4E9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#81747C"/>
        <SolidColorBrush x:Key="TintBrush" Color="#F2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#956B88"/>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="4,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Width="6" HorizontalAlignment="Center" IsDirectionReversed="True" Orientation="Vertical"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ScrollThumb" Background="#D8CCD4" CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ScrollThumb" Property="Background" Value="#BCAAB6"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TintBrush}"/>
                                <Setter Property="Foreground" Value="#433B42"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E8D9E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SendSurface" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SendSurface" Property="Background" Value="#835B77"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SendSurface" Property="Background" Value="#714D66"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#433B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#433B42"/>
            <Setter Property="SelectionBrush" Value="#DCC8D6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.Effect>
            <DropShadowEffect Color="#6F5067" BlurRadius="20" ShadowDepth="4" Opacity="0.18"/>
        </Grid.Effect>
        <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="22" Margin="0,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="18,13,13,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewChatButton" Content="&#xE8F2;" Click="OnNewChat" Style="{StaticResource QuietButton}"
                            ToolTip="新对话" AutomationProperties.Name="新对话"/>
                    <Button x:Name="ExpandButton" Content="&#xE740;" Click="OnExpand" Style="{StaticResource QuietButton}"
                            ToolTip="展开完整聊天" AutomationProperties.Name="展开完整聊天"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="我在这里" FontSize="13" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" MaxHeight="320" Margin="18,6,13,4"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="VerticalOnly">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,5,15">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="2,2,8,2"/>
                                        <Setter Property="MaxWidth" Value="292"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="{StaticResource TintBrush}"/>
                                                <Setter Property="Padding" Value="12,9"/>
                                                <Setter Property="CornerRadius" Value="16,16,5,16"/>
                                                <Setter Property="MaxWidth" Value="268"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ChatTextBox}"
                                         IsReadOnly="True" TextWrapping="Wrap" Padding="0" FontSize="14"
                                         TextBlock.LineHeight="23" TextBlock.LineStackingStrategy="BlockLineHeight"
                                         AutomationProperties.Name="{Binding Speaker}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="18,0,18,10"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Border x:Name="Composer" Grid.Row="3" Margin="12,2,12,12" Padding="7"
                    Background="{StaticResource PaperBrush}" BorderThickness="1" CornerRadius="15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#CBB1C2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Style="{StaticResource ChatTextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="36" MaxHeight="88" VerticalScrollBarVisibility="Auto" Padding="7,7,5,5"
                             MaxLength="4000" PreviewKeyDown="OnInputKeyDown" GotKeyboardFocus="OnInputFocused"
                             TextChanged="OnInputTextChanged" FontSize="13" ToolTip="Enter 发送 · Shift+Enter 换行"
                             AutomationProperties.Name="想对她说的话"/>
                    <TextBlock Text="想说什么，都可以…" Margin="7,7,5,5" Foreground="{StaticResource MutedBrush}"
                               FontSize="13" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="SendButton" Grid.Column="1" Content="↑" Click="OnSend" VerticalAlignment="Bottom"
                            Style="{StaticResource SendButtonStyle}" ToolTip="发送" AutomationProperties.Name="发送"/>
                </Grid>
            </Border>
          </Grid>
        </Border>
        <Grid x:Name="BubbleTail" Width="22" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="28,0,28,0" IsHitTestVisible="False">
            <Path Fill="{StaticResource PaperBrush}" Data="M 0,0 L 22,0 Q 10,7 0,14 Z"/>
            <Path Stroke="{StaticResource LineBrush}" StrokeThickness="1" Data="M 22,0 Q 10,7 0,14 L 0,0"/>
        </Grid>
    </Grid>
</Window>
