<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DesktopPet</AssemblyName>
    <RootNamespace>DesktopPet</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- Character-derived icon, so the exe and any shortcut show the pet rather than the
         generic .NET icon. Generated from the sprite art; see README. -->
    <ApplicationIcon>Assets\DesktopPet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
    <!-- One folder per animation; the folder name is the state prefix the loader looks for.
         Recursive so adding a new state is just dropping in a folder. Assets\Character itself
         holds only subfolders, so this cannot pick up loose stray images. -->
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Video\LeftWalk\*.mov" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
