<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DesktopPet</AssemblyName>
    <RootNamespace>DesktopPet</RootNamespace>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
    <Resource Include="Assets\Character\*.png" />
    <!-- Kept in the repository as the source the idle frames were extracted from.
         Deliberately NOT copied to the build output: it is 24.8 MB and nothing
         reads it at runtime. Idle playback uses the embedded PNG frames. -->
    <None Include="Assets\idle_blink.mov" />
  </ItemGroup>
</Project>
