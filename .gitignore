# ---------------------------------------------------------------------------
# Desktop Pet (.NET 8 / WPF) — ignored paths
#
# Everything below is generated or machine-specific. A fresh clone plus
# `dotnet build` / `dotnet test` reproduces all of it, so none of it is tracked.
# ---------------------------------------------------------------------------

# --- Build output ---
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
artifacts/
*.dll
*.exe
*.pdb
*.cache

# --- Publish output (publish.ps1 writes a self-contained win-x64 build here) ---
# Not tracked: a self-contained single-file build is very large (well over
# 100 MB). Build it locally or attach it to a GitHub Release instead of
# committing it.
[Pp]ublish/

# --- Visual Studio / Rider / VS Code ---
.vs/
.idea/
.vscode/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.svclog
launchSettings.json
.vsconfig
.fleet/
.history/

# --- Test, coverage, and profiling output ---
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.coverlet.json
[Cc]overage[Rr]eport/
*.dotCover
*.ncrunch*
_ReSharper*/
*.psess
*.vsp
*.vspx

# --- NuGet ---
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json

# --- MSBuild and build logs ---
*.binlog
msbuild.log
msbuild.err
msbuild.wrn
*.buildlog

# --- Source photographs and scratch media (privacy + size) ---
# tools/make_photo_pet.py reads tools/reference.jpg. The source photograph is
# deliberately never committed and never bundled: only the derived,
# background-free PNG frames under src/DesktopPet/Assets/Character/ are tracked.
tools/reference.jpg
tools/reference.jpeg
tools/reference.png

# Scratch frames extracted from the reference video while authoring the art.
# Nothing in the app reads these, and they are regenerable from the video:
#   frame.raw     raw RGBA dump (640 x 640 x 4 = 1,638,400 bytes)
#   mov_frame.png / sample.png   inspection stills
# The files themselves were deleted; these rules stay so re-running the same
# exploratory commands cannot pollute the tree again.
*.raw
tools/mov_frame.png
tools/sample.png

# Other media formats are scratch unless the project explicitly ships them.
*.mov
*.psd
*.xcf
*.blend*

# Source clips the sprite frames were extracted from. Kept in the working copy so the art can be
# regenerated, but never committed: they are ~83 MB together, about 92% of the working tree, and
# nothing reads them at runtime. The frames derived from them are fully committed, so a clone
# builds and runs without these. videos/README.md itself IS committed, so the folder and the
# regeneration instructions survive a clone.
videos/*.mov

# --- Python tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Local scratch ---
*.tmp
*.bak
*.orig
*.rej
*.swp
*~
*.log
